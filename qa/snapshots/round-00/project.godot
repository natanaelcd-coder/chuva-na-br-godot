; Engine configuration file.
config_version=5

[application]

config/name="Chuva na BR"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.094, 1)
