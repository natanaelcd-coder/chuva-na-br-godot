shader_type canvas_item;
// Snaps the whole frame to a fixed 55-colour palette with a 4x4 ordered dither.
uniform sampler2D screen_texture : hint_screen_texture, filter_nearest, repeat_disable;
const int PAL_N = 55;
const vec3 PAL[55] = vec3[](
	vec3(0.0196, 0.0275, 0.0471),
	vec3(0.0431, 0.0627, 0.1255),
	vec3(0.0706, 0.1020, 0.2000),
	vec3(0.1020, 0.1451, 0.2784),
	vec3(0.1412, 0.2039, 0.3725),
	vec3(0.1843, 0.2824, 0.4706),
	vec3(0.2392, 0.3725, 0.5804),
	vec3(0.3216, 0.4745, 0.6784),
	vec3(0.4353, 0.5922, 0.7686),
	vec3(0.6078, 0.7333, 0.8784),
	vec3(0.8118, 0.8784, 0.9490),
	vec3(0.0863, 0.1255, 0.1686),
	vec3(0.1333, 0.1882, 0.2471),
	vec3(0.1882, 0.2745, 0.3529),
	vec3(0.2471, 0.3647, 0.4588),
	vec3(0.3373, 0.5098, 0.6275),
	vec3(0.4784, 0.6549, 0.7608),
	vec3(0.0392, 0.0392, 0.0588),
	vec3(0.1647, 0.1725, 0.2000),
	vec3(0.2902, 0.3020, 0.3412),
	vec3(0.4667, 0.4824, 0.5255),
	vec3(0.6588, 0.6745, 0.7098),
	vec3(0.9020, 0.9098, 0.9333),
	vec3(0.2275, 0.0510, 0.0706),
	vec3(0.4784, 0.0863, 0.1255),
	vec3(0.7608, 0.1490, 0.1882),
	vec3(0.9412, 0.2824, 0.2902),
	vec3(1.0000, 0.6039, 0.5412),
	vec3(0.4784, 0.2902, 0.0627),
	vec3(0.7686, 0.4784, 0.1098),
	vec3(0.9490, 0.6510, 0.1647),
	vec3(1.0000, 0.8392, 0.3529),
	vec3(1.0000, 0.9529, 0.6902),
	vec3(0.0471, 0.1647, 0.1098),
	vec3(0.0863, 0.2824, 0.1725),
	vec3(0.1373, 0.4549, 0.2471),
	vec3(0.2471, 0.6824, 0.3529),
	vec3(0.5608, 0.8784, 0.4784),
	vec3(0.1686, 0.1020, 0.0706),
	vec3(0.2902, 0.1765, 0.1098),
	vec3(0.4314, 0.2706, 0.1490),
	vec3(0.5882, 0.3922, 0.2275),
	vec3(0.7765, 0.5412, 0.3529),
	vec3(0.8902, 0.6706, 0.4863),
	vec3(0.9529, 0.8118, 0.6510),
	vec3(0.0980, 0.7843, 0.8471),
	vec3(0.2275, 0.1647, 0.3333),
	vec3(0.4157, 0.2902, 0.4784),
	vec3(0.6902, 0.4157, 0.5020),
	vec3(0.9098, 0.6039, 0.4784),
	vec3(0.0392, 0.0863, 0.0784),
	vec3(0.0627, 0.1490, 0.1216),
	vec3(0.1137, 0.2510, 0.1882),
	vec3(0.2902, 0.4157, 0.5804),
	vec3(0.6627, 0.7529, 0.8471));
const float BAYER[16] = float[](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);

void fragment() {
	vec3 c = texture(screen_texture, SCREEN_UV).rgb;
	ivec2 p = ivec2(FRAGCOORD.xy);
	c = clamp(c + (BAYER[(p.y & 3) * 4 + (p.x & 3)] / 16.0 - 0.5) * 14.0 / 255.0, 0.0, 1.0);
	float bd = 1e9;
	vec3 best = c;
	for (int i = 0; i < PAL_N; i++) {
		vec3 d = PAL[i] - c;
		float dist = dot(d * d, vec3(2.0, 4.0, 3.0));
		if (dist < bd) { bd = dist; best = PAL[i]; }
	}
	COLOR = vec4(best, 1.0);
}
